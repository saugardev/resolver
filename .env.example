# Required resolver credential used for the Spider upstream.
LIVY_RESOLVER_KEY=
SPIDER_API_URL=https://api.spider.cloud
LIVY_RESOLVER_MAX_UPSTREAM_BYTES=8388608

# Listener.
PORT=3001

# OAuth is enabled by default. Disable only for local development.
LIVY_RESOLVER_AUTH_ENABLED=true
LIVY_OAUTH_ISSUER=https://auth.livylabs.xyz
LIVY_OAUTH_INTROSPECTION_URL=https://auth.livylabs.xyz/oauth/introspect
LIVY_RESOLVER_OAUTH_AUDIENCE=https://resolver.api.livylabs.xyz/mcp
LIVY_RESOLVER_OAUTH_RESOURCE_METADATA_URL=https://resolver.api.livylabs.xyz/.well-known/oauth-protected-resource

# HTTP hardening. HSTS should only be enabled when served through HTTPS.
LIVY_RESOLVER_MAX_PRODUCT_BODY_BYTES=65536
LIVY_RESOLVER_PRODUCT_TIMEOUT_SECS=65
LIVY_RESOLVER_HSTS_ENABLED=false

# Credit enforcement.
LIVY_RESOLVER_CREDITS_ENABLED=true
LIVY_RESOLVER_REQUEST_CREDIT_COST=1
# Optional per-route overrides use the normalized route name.
# LIVY_RESOLVER_CREDIT_COST_CRAWL=5
# LIVY_RESOLVER_CREDIT_COST_SCREENSHOT=3
# LIVY_RESOLVER_CREDIT_COST_MCP_FETCH_SOURCE=1
LIVY_BACKEND_BASE_URL=https://api.livylabs.xyz

# The built-in receipt store is bounded and single-replica only. Every
# environment requires this explicit exception; production should instead
# inject an async shared durable ReceiptStoreFactory. No durable implementation
# is shipped here, and this exception is not a durability guarantee.
LIVY_RESOLVER_RECEIPT_STORE=memory
LIVY_RESOLVER_RECEIPT_TTL_SECS=900
LIVY_RESOLVER_RECEIPT_CAPACITY=10000
LIVY_RESOLVER_ALLOW_IN_MEMORY_RECEIPTS=true

# Optional provenance. Credentials and LIVY_BACKEND_BASE_URL never enable it.
LIVY_PROVENANCE_ENABLED=false
LIVY_PROVENANCE_SCHEMA_ID=resolver-fetch-v1
LIVY_PROVENANCE_SCHEMA_VERSION=1
LIVY_PROVENANCE_VISIBILITY=private
LIVY_PROVENANCE_MANAGED_PUBLICATION=false
LIVY_PROVENANCE_PUBLISH_RESPONSE_ARTIFACT=false
LIVY_PROVENANCE_ALLOW_PUBLIC_DISCLOSURE=false
LIVY_PROVENANCE_RESPONSE_ARTIFACT_MAX_BYTES=262144
