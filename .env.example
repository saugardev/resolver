# Required resolver credential used for the Spider upstream.
LIVY_RESOLVER_KEY=

# Listener.
PORT=3001

# OAuth is enabled by default. Disable only for local development.
LIVY_RESOLVER_AUTH_ENABLED=true
LIVY_OAUTH_ISSUER=https://auth.livylabs.xyz
LIVY_OAUTH_INTROSPECTION_URL=https://auth.livylabs.xyz/oauth/introspect
LIVY_RESOLVER_OAUTH_AUDIENCE=https://resolver.api.livylabs.xyz/mcp
LIVY_RESOLVER_OAUTH_RESOURCE_METADATA_URL=https://resolver.api.livylabs.xyz/.well-known/oauth-protected-resource
LIVY_RESOLVER_OAUTH_TIMEOUT_SECS=10
# Add legacy/alternate audiences only after an explicit compatibility review.
# LIVY_RESOLVER_OAUTH_ACCEPTED_AUDIENCES=https://resolver.api.livylabs.xyz

# HTTP hardening. HSTS should only be enabled when served through HTTPS.
LIVY_RESOLVER_MAX_PRODUCT_BODY_BYTES=65536
LIVY_RESOLVER_PRODUCT_TIMEOUT_SECS=65
LIVY_RESOLVER_MCP_TIMEOUT_SECS=65
LIVY_RESOLVER_HSTS_ENABLED=false

# MCP DNS-rebinding protection. Production must list its public authority and
# browser origins. The defaults accept only local Host/Origin values.
LIVY_RESOLVER_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1
LIVY_RESOLVER_MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Source egress is public-only by default, and every DNS answer is checked.
LIVY_RESOLVER_DNS_TIMEOUT_SECS=3
LIVY_RESOLVER_ALLOW_PRIVATE_SOURCES=false
# Narrow trusted override for operator-controlled internal source names.
# LIVY_RESOLVER_TRUSTED_SOURCE_HOSTS=docs.internal.example

# Credit enforcement.
LIVY_RESOLVER_CREDITS_ENABLED=true
LIVY_RESOLVER_REQUEST_CREDIT_COST=1
LIVY_BACKEND_BASE_URL=https://api.livylabs.xyz

# Optional provenance.
LIVY_PROVENANCE_ENABLED=false
LIVY_PROVENANCE_PUBLISH_RESPONSE_ARTIFACT=true
LIVY_PROVENANCE_RESPONSE_ARTIFACT_MAX_BYTES=262144
